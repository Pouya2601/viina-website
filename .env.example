# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in the two values below from your Supabase project
# (Settings -> API in the Supabase dashboard). Full steps in README.md.
#
# On Netlify, do NOT upload a .env file — instead add these same two
# variables under Site settings -> Environment variables.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
